---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/ui/BrandMark.astro";
import { APPS, LIVE_APPS } from "../data/apps";

const shipped = APPS.length;
const live = LIVE_APPS.length;
---

<BaseLayout
  title="About | Dalsicore"
  description="Dalsicore is a solo Android studio in Indonesia, started as Euni Dev. 20+ apps shipped, one live product, and a lot learned from the ones that failed."
>
  <section class="section container about">
    <p class="eyebrow reveal">About</p>
    <h1 class="section-title reveal delay-1">One person, 20+ shipped apps, and a lot of lessons that only came from failing.</h1>

    <div class="cols">
      <div class="prose reveal delay-2">
        <p class="lead">
          I'm <strong>Anaf Naufalian</strong>, and I run Dalsicore on my own from Indonesia.
        </p>

        <p>
          I started out shipping apps under the name <strong>Euni Dev</strong>. Between 2022 and
          2024 I published more than 20 apps to Google Play. Almost none of them got traction. A
          few picked up a handful of installs and some kind ratings. Most picked up nothing at all.
          One by one, I retired them.
        </p>

        <p>
          That stretch taught me more than a success would have. Shipping is a skill. Getting people
          to come back is a different problem. So I stopped counting apps and started working on
          depth instead.
        </p>

        <p>
          In 2025 I rebranded to <strong>Dalsicore</strong>. Fewer products, better execution, and
          AI built into how the work gets done.
        </p>

        <p>
          Today Dalsicore ships an Android subscription tracker, builds a hydration product, and
          runs research into color accessibility on mobile. The name is new. The habit of ship,
          measure, learn, ship again is not.
        </p>
      </div>

      <aside class="side reveal delay-3">
        <div class="card surface">
          <div class="card-head">
            <BrandMark />
            <span>Dalsicore</span>
          </div>
          <dl>
            <div>
              <dt>Founder</dt>
              <dd>Anaf Naufalian</dd>
            </div>
            <div>
              <dt>Founded</dt>
              <dd>2025, rebranded from Euni Dev</dd>
            </div>
            <div>
              <dt>Team</dt>
              <dd>One, a solo founder</dd>
            </div>
            <div>
              <dt>Based in</dt>
              <dd>Indonesia</dd>
            </div>
            <div>
              <dt>Apps shipped</dt>
              <dd>{shipped}+</dd>
            </div>
            <div>
              <dt>Live products</dt>
              <dd>{live}</dd>
            </div>
          </dl>
        </div>

        <div class="card surface claude">
          <p class="eyebrow">AI-native</p>
          <h2>Built with Claude, not just assisted by it</h2>
          <p>
            Our live product was built end to end with Claude. Described, reviewed, iterated, with
            no hand-written code. It is how one person ships what used to take a team.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: 1120px;
  }

  .cols {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  .prose {
    display: grid;
    gap: var(--space-4);
  }

  .prose p {
    margin: 0;
    color: var(--text-1);
    font-size: 1.06rem;
    line-height: 1.72;
  }

  .prose .lead {
    color: var(--text-0);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.5;
  }

  .prose strong {
    color: var(--text-0);
  }

  .side {
    display: grid;
    gap: var(--space-4);
    position: sticky;
    top: 92px;
  }

  .card {
    padding: var(--space-5);
  }

  .card-head {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  dl {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  dl > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    border-bottom: 1px solid var(--border-0);
    padding-bottom: var(--space-3);
  }

  dl > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  dt {
    color: var(--text-2);
    font-size: 0.86rem;
  }

  dd {
    margin: 0;
    color: var(--text-0);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: right;
  }

  .claude {
    background: var(--bg-1);
  }

  .claude h2 {
    margin: 0 0 var(--space-2);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .claude p {
    margin: 0;
    color: var(--text-1);
    font-size: 0.94rem;
  }

  @media (max-width: 960px) {
    .cols {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .side {
      position: static;
    }
  }
</style>
