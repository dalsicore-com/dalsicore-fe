---
import { APPS } from "../../data/apps";
import { metricsFor, METRICS } from "../../data/metrics";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AreaChart from "../../components/charts/AreaChart.astro";
import BrandBars from "../../components/charts/BrandBars.astro";

export function getStaticPaths() {
  return APPS.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const isLive = app.status === "live";
const metric = metricsFor(app.slug);
const METRICS_END = METRICS.range.end;
const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC"
  });
---

<BaseLayout
  title={`${app.name} | Dalsicore`}
  description={app.tagline}
  ogType="article"
>
  <article class="section container entry">
    <a class="back reveal" href={isLive ? "/portfolio" : "/archive"}>
      {isLive ? "Back to products" : "Back to archive"}
    </a>

    <header class="head reveal delay-1">
      <img class="icon" src={app.icon} alt={`${app.name} icon`} width="88" height="88" />
      <div class="meta">
        <h1>{app.name}</h1>
        <p class="cat">{app.category}</p>
        <div class="chips">
          {
            isLive ? (
              <span class="chip live">Live on Google Play</span>
            ) : (
              <span class="chip">Retired {app.retired}</span>
            )
          }
          <span class="chip">Shipped {app.shipped}</span>
          {app.rating && <span class="chip">★ {app.rating.toFixed(1)} avg</span>}
          
        </div>
      </div>
    </header>

    <div class="body">
      <div class="copy surface reveal delay-2">
        <p class="lead">{app.tagline}</p>
        <p class="muted">{app.description}</p>

        <div class="links">
          {
            app.links?.play && (
              <a class="btn btn-primary" href={app.links.play} target="_blank" rel="noopener noreferrer">
                View on Google Play
              </a>
            )
          }
          {
            app.links?.github && (
              <a class="btn btn-ghost" href={app.links.github} target="_blank" rel="noopener noreferrer">
                Source
              </a>
            )
          }
          {
            !isLive && (
              <span class="note">This listing has been retired and is no longer installable.</span>
            )
          }
        </div>
      </div>

      <div class="gallery reveal delay-3">
        <h2>Screenshots</h2>
        <div class="shots">
          {
            app.screenshots.map((src) => (
              <img src={src} alt={`${app.name} screenshot`} loading="lazy" decoding="async" />
            ))
          }
        </div>
      </div>

      {
        metric && (
          <section class="reach reveal">
            <div class="reach-head">
              <h2>Reach</h2>
              <p class="muted">
                Installed audience from Google Play Console, {fmtDate(metric.firstActive ?? metric.peakDate)}{" "}
                to {fmtDate(METRICS_END)}.
              </p>
            </div>

            <dl class="reach-stats">
              <div>
                <dt>Peak installed</dt>
                <dd>{metric.peak.toLocaleString("en-US")}</dd>
                <dd class="sub">{fmtDate(metric.peakDate)}</dd>
              </div>
              <div>
                <dt>Markets</dt>
                <dd>{metric.countries.length}</dd>
                <dd class="sub">top markets reported by Play</dd>
              </div>
            </dl>

            <AreaChart
              series={metric.series}
              id={`app-${app.slug}`}
              label={`Installed audience for ${app.name} over time`}
              height={230}
            />

            <div class="reach-countries">
              <h3>Top markets</h3>
              <BrandBars items={metric.countries.slice(0, 6)} />
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .entry {
    max-width: 1120px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-2);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent-1);
  }

  .head {
    margin-top: var(--space-4);
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }

  .icon {
    border-radius: 22px;
    background: var(--surface-2);
    flex: none;
  }

  .meta {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    letter-spacing: -0.03em;
  }

  .cat {
    margin: 0.3rem 0 0;
    color: var(--text-2);
    font-size: 0.9rem;
  }

  .chips {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    border: 1px solid var(--border-0);
    border-radius: 6px;
    padding: 0.24rem 0.7rem;
    color: var(--text-1);
    font-size: 0.76rem;
    font-weight: 600;
  }

  .chip.live {
    border-color: rgba(34, 197, 94, 0.4);
    color: #15803d;
    background: rgba(34, 197, 94, 0.08);
  }

  .body {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-6);
  }

  .copy {
    padding: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  .copy .lead {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--text-0);
  }

  .copy .muted {
    margin: 0;
  }

  .links {
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .note {
    color: var(--text-2);
    font-size: 0.85rem;
  }

  .gallery h2 {
    margin: 0 0 var(--space-4);
    font-size: 1.2rem;
  }

  .shots {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    padding-bottom: var(--space-3);
    scroll-snap-type: x mandatory;
  }

  .shots img {
    height: 460px;
    width: auto;
    border-radius: var(--radius-2);
    border: 1px solid var(--border-0);
    background: var(--surface-2);
    scroll-snap-align: start;
    flex: none;
  }

  @media (max-width: 700px) {
    .shots img {
      height: 360px;
    }
  }

  .reach {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-0);
  }

  .reach-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .reach-head h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .reach-head p {
    margin: 0;
    font-size: 0.9rem;
  }

  .reach-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 200px));
    gap: var(--space-5);
    margin: 0 0 var(--space-5);
  }

  .reach-stats dt {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-2);
  }

  .reach-stats dd {
    margin: 0.15rem 0 0;
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-0);
    font-variant-numeric: tabular-nums;
  }

  .reach-stats dd.sub {
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--text-2);
    margin-top: 0.1rem;
  }

  .reach-countries {
    margin-top: var(--space-6);
  }

  .reach-countries h3 {
    margin: 0 0 var(--space-3);
    font-size: 1rem;
  }
</style>
