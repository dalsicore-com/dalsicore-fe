---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppCard from "../../components/home/AppCard.astro";
import { LIVE_APPS, RETIRED_APPS } from "../../data/apps";

const products = (await getCollection("portfolio")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Products | Dalsicore"
  description="What Dalsicore is building now: a live Android product, an app in development, and applied research."
>
  <section class="section container">
    <p class="eyebrow reveal">What we build</p>
    <h1 class="section-title reveal delay-1">Products</h1>
    <p class="lead intro reveal delay-2">
      Dalsicore is deliberately small. One live product, one in development, and a research stream,
      plus a shelf of shipped apps that taught us how to get here.
    </p>

    <h2 class="group-title reveal delay-2">Live &amp; in development</h2>
  </section>

  <section class="container">
    <div class="grid-3 reveal delay-2">
      {LIVE_APPS.map((app) => <AppCard app={app} />)}
      {
        products.map((entry) => (
          <a class="concept surface" href={`/portfolio/${entry.slug}`}>
            <div class="top">
              <h3>{entry.data.title}</h3>
              <span class="badge">{entry.data.status.replace("-", " ")}</span>
            </div>
            <p>{entry.data.summary}</p>
            <div class="tags">
              {entry.data.stack.map((item) => <span class="tag">{item}</span>)}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <h2 class="group-title reveal">Shipped &amp; retired</h2>
    <p class="lead intro reveal delay-1">
      Listings we've since unpublished. Kept visible on purpose.
    </p>
    <div class="grid-3 reveal delay-2">
      {RETIRED_APPS.map((app) => <AppCard app={app} />)}
    </div>
    <p class="muted more reveal delay-3">
      See the full set, with context, in the <a class="text-link" href="/archive">archive</a>
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 62ch;
  }

  .group-title {
    margin: var(--space-6) 0 var(--space-4);
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    letter-spacing: -0.02em;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .concept {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .concept:hover {
    transform: translateY(-3px);
    border-color: var(--border-1);
    box-shadow: var(--shadow-1);
  }

  .top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .concept h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .badge {
    flex: none;
    border: 1px solid var(--border-0);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
    color: var(--text-2);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: capitalize;
    white-space: nowrap;
  }

  .concept p {
    margin: 0;
    color: var(--text-1);
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .more {
    margin-top: var(--space-5);
  }

  @media (max-width: 960px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
