---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT } from "../lib/constants";
---

<BaseLayout
  title="Contact | Dalsicore"
  description="Get in touch with Dalsicore for feedback, collaboration, or questions about what I build."
>
  <section class="section container">
    <p class="eyebrow reveal">Contact</p>
    <h1 class="section-title reveal delay-1">Let's talk</h1>
    <p class="lead intro reveal delay-2">
      Questions about the products I build, feedback on an app, or want to compare notes on
      shipping AI-native software? Reach out.
    </p>

    <div class="cards reveal delay-3">
      <a class="surface card" href={`mailto:${CONTACT.email}`}>
        <h2>Email</h2>
        <p>{CONTACT.email}</p>
      </a>
      <a class="surface card" href={CONTACT.github} target="_blank" rel="noopener noreferrer">
        <h2>GitHub</h2>
        <p>github.com/dalsicore</p>
      </a>
      <a class="surface card" href={CONTACT.play} target="_blank" rel="noopener noreferrer">
        <h2>Google Play</h2>
        <p>Dalsicore developer page</p>
      </a>
      <div class="surface card static">
        <h2>Location</h2>
        <p>Indonesia</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 58ch;
  }

  .cards {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: 820px;
  }

  .card {
    position: relative;
    padding: var(--space-5);
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .card:not(.static):hover {
    transform: translateY(-3px);
    border-color: var(--border-1);
    box-shadow: var(--shadow-1);
  }

  h2 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  p {
    margin: var(--space-2) 0 0;
    color: var(--text-1);
    font-size: 0.95rem;
  }

  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
