---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import ProjectCard from "../components/portfolio/ProjectCard.astro";
import BlogCard from "../components/blog/BlogCard.astro";
import ResearchCard from "../components/research/ResearchCard.astro";
import { BLOG_SOURCE } from "../lib/constants";
import { getFirstImageFromMarkdown } from "../lib/blog";
import { getMediumPosts } from "../lib/medium";

const portfolio = (await getCollection("portfolio"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const blog =
  BLOG_SOURCE === "medium"
    ? (await getMediumPosts()).slice(0, 2).map((entry) => ({
        slug: entry.slug,
        title: entry.title,
        excerpt: entry.excerpt,
        publishedAt: entry.publishedAt,
        author: entry.author,
        tags: entry.tags,
        thumbnail: entry.thumbnail
      }))
    : (await getCollection("blog", ({ data }) => !data.draft))
        .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
        .slice(0, 2)
        .map((entry) => ({
          slug: entry.slug,
          title: entry.data.title,
          excerpt: entry.data.excerpt,
          publishedAt: entry.data.publishedAt,
          author: entry.data.author,
          tags: entry.data.tags,
          thumbnail: getFirstImageFromMarkdown(entry.body)
        }));

const research = (await getCollection("research")).slice(0, 1);
---

<BaseLayout title="Dalsicore">
  <Hero />

  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">What Dalsicore Builds</p>
      <h2 class="section-title reveal delay-1">Portfolio</h2>
      <p class="muted intro reveal delay-2">
          Android apps, experiments, and prototypes built to turn ideas into something people can actually use.
      </p>
      <div class="grid reveal delay-3">
        {
          portfolio.map((entry, idx) => (
            <ProjectCard
              href={`/portfolio/${entry.slug}`}
              title={entry.data.title}
              summary={entry.data.summary}
              status={entry.data.status.replace("-", " ")}
              stack={entry.data.stack}
              index={idx}
            />
          ))
        }
      </div>
      <div class="section-cta reveal delay-3">
        <a href="/portfolio">Explore all projects</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Research Direction</p>
      <h2 class="section-title reveal delay-1">Applied Research</h2>
      <div class="grid single reveal delay-2">
        {
          research.map((entry) => (
            <ResearchCard
              href={`/research/${entry.slug}`}
              title={entry.data.title}
              abstract={entry.data.abstract}
              field={entry.data.field}
              status={entry.data.status}
              platform={entry.data.platform}
              tags={entry.data.tags}
            />
          ))
        }
      </div>
      <div class="section-cta reveal delay-3">
        <a href="/research">View research stream</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Blog</p>
      <h2 class="section-title reveal delay-1">Latest Writing</h2>
      <div class="grid reveal delay-2">
        {
          blog.map((entry, idx) => (
            <BlogCard
              href={`/blog/${entry.slug}`}
              title={entry.title}
              excerpt={entry.excerpt}
              publishedAt={entry.publishedAt}
              author={entry.author}
              thumbnail={entry.thumbnail}
              tags={entry.tags}
              index={idx}
            />
          ))
        }
      </div>
      <div class="section-cta reveal delay-3">
        <a href="/blog">Read more writing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-top: var(--space-3);
    max-width: 64ch;
  }

  .grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .grid.single {
    grid-template-columns: 1fr;
  }

  .section-cta {
    margin-top: var(--space-4);
  }

  .section-cta a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.16rem 0.1rem;
    text-decoration: none;
    color: var(--accent-1);
    font-weight: 700;
    transition: transform 0.18s ease, color 0.18s ease;
    will-change: transform;
  }

  .section-cta a::after {
    content: "↗";
    font-size: 0.85rem;
  }

  .section-cta a:hover {
    color: var(--text-0);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const magneticLinks = Array.from(document.querySelectorAll(".section-cta a"));

  const resetLink = (link) => {
    link.style.transform = "translate3d(0, 0, 0)";
  };

  magneticLinks.forEach((link) => {
    link.addEventListener("mousemove", (event) => {
      const rect = link.getBoundingClientRect();
      const x = event.clientX - rect.left - rect.width / 2;
      const y = event.clientY - rect.top - rect.height / 2;
      const moveX = Math.max(-8, Math.min(8, x * 0.18));
      const moveY = Math.max(-6, Math.min(6, y * 0.18));
      link.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
    });

    link.addEventListener("mouseleave", () => {
      resetLink(link);
    });
  });

  const orbit = document.querySelector("[data-parallax]");
  if (orbit) {
    const strength = Number(orbit.getAttribute("data-parallax")) || 0.1;
    window.addEventListener("mousemove", (event) => {
      const centerX = window.innerWidth / 2;
      const centerY = window.innerHeight / 2;
      const dx = (event.clientX - centerX) * strength;
      const dy = (event.clientY - centerY) * strength;
      orbit.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
    });
  }
</script>
