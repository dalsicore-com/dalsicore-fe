---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import AppCard from "../components/home/AppCard.astro";
import BlogCard from "../components/blog/BlogCard.astro";
import AreaChart from "../components/charts/AreaChart.astro";
import { APPS, LIVE_APPS, RETIRED_APPS } from "../data/apps";
import { METRICS } from "../data/metrics";
import { BLOG_SOURCE } from "../lib/constants";
import { getFirstImageFromMarkdown } from "../lib/blog";
import { getMediumPosts } from "../lib/medium";

const featured = APPS.filter((a) => a.featured);
const archivePreview = RETIRED_APPS.slice(0, 6);

const blog =
  BLOG_SOURCE === "medium"
    ? (await getMediumPosts()).slice(0, 3).map((entry) => ({
        slug: entry.slug,
        title: entry.title,
        excerpt: entry.excerpt,
        publishedAt: entry.publishedAt,
        author: entry.author,
        tags: entry.tags,
        thumbnail: entry.thumbnail
      }))
    : (await getCollection("blog", ({ data }) => !data.draft))
        .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
        .slice(0, 3)
        .map((entry) => ({
          slug: entry.slug,
          title: entry.data.title,
          excerpt: entry.data.excerpt,
          publishedAt: entry.data.publishedAt,
          author: entry.data.author,
          tags: entry.data.tags,
          thumbnail: getFirstImageFromMarkdown(entry.body)
        }));

const research = (await getCollection("research")).slice(0, 1);
const liveCount = LIVE_APPS.length;
const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
    timeZone: "UTC"
  });
---

<BaseLayout>
  <Hero />

  <!-- Latest -->
  <section class="section container">
    <div class="sec-head">
      <div>
        <p class="eyebrow reveal">Latest writing</p>
        <h2 class="section-title reveal delay-1">Notes from the build</h2>
      </div>
      <a class="text-link reveal delay-2" href="/blog">All posts</a>
    </div>
    <div class="grid-3 reveal delay-2">
      {
        blog.map((entry, idx) => (
          <BlogCard
            href={`/blog/${entry.slug}`}
            title={entry.title}
            excerpt={entry.excerpt}
            publishedAt={entry.publishedAt}
            author={entry.author}
            thumbnail={entry.thumbnail}
            tags={entry.tags}
            index={idx}
          />
        ))
      }
    </div>
  </section>

  <!-- What I build -->
  <section class="section band">
    <div class="container">
      <div class="sec-head">
        <div>
          <p class="eyebrow reveal">What I build</p>
          <h2 class="section-title reveal delay-1">Products</h2>
        </div>
        <a class="text-link reveal delay-2" href="/portfolio">All products</a>
      </div>

      <div class="grid-3 reveal delay-2">
        {featured.map((app) => <AppCard app={app} />)}
      </div>

      <p class="muted aside reveal delay-3">
        Plus an applied-research stream,{" "}
        <a class="inline-link" href="/research">{research[0]?.data.shortTitle ?? "Dalsilens"}</a>,
        bringing color-blindness assistance to mobile.
      </p>
    </div>
  </section>

  <!-- The honest archive -->
  <section class="section container">
    <div class="archive-head reveal">
      <p class="eyebrow">The honest archive</p>
      <h2 class="section-title">20+ apps shipped. Most since retired.</h2>
      <p class="lead">
        Between 2022 and 2024 I published app after app under my earlier name,{" "}
        <strong>Euni Dev</strong>. Most stayed small, so I retired them one by one. The listings
        are still here, because shipping is a skill and this is where mine came from.
      </p>
      <a class="btn btn-ghost" href="/archive">Read the archive</a>
    </div>

    <div class="grid-3 reveal delay-2">
      {archivePreview.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  <!-- Reach -->
  <section class="section band">
    <div class="container">
      <div class="sec-head">
        <div>
          <p class="eyebrow reveal">Reach</p>
          <h2 class="section-title reveal delay-1">The numbers, in the open.</h2>
        </div>
        <a class="text-link reveal delay-2" href="/reach">Full dashboard</a>
      </div>

      <p class="lead reach-lead reveal delay-2">
        Every day since {fmtDate(METRICS.range.start)}, tracked in Google Play Console across{" "}
        {METRICS.appsTracked} apps in {METRICS.countriesCount} countries. Nothing hidden, nothing
        smoothed.
      </p>

      <div class="reveal delay-2">
        <AreaChart series={METRICS.series} id="home-reach" label="Combined installed audience, 2021 to 2026" height={260} />
      </div>

      <div class="reach-facts reveal delay-3">
        <div>
          <strong>{METRICS.peak.value.toLocaleString("en-US")}</strong>
          <span>peak installed devices, {fmtDate(METRICS.peak.date)}</span>
        </div>
        <div>
          <strong>{METRICS.countriesCount}</strong>
          <span>countries reached</span>
        </div>
        <div>
          <strong>{METRICS.appsTracked}</strong>
          <span>apps with full history</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section container">
    <div class="stats surface reveal">
      <div class="stat">
        <strong>20+</strong>
        <span>Apps shipped</span>
      </div>
      <div class="stat">
        <strong>{liveCount}</strong>
        <span>Live product</span>
      </div>
      <div class="stat">
        <strong>100%</strong>
        <span>Built with Claude</span>
      </div>
      <div class="stat">
        <strong>2022</strong>
        <span>Building since</span>
      </div>
    </div>

    <div class="cta reveal delay-1">
      <div>
        <h2 class="section-title">Building something with AI?</h2>
        <p class="muted">Want to compare notes on shipping AI-native products? Say hello.</p>
      </div>
      <a class="btn btn-primary" href="/contact">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .band {
    background: var(--bg-1);
    border-top: 1px solid var(--border-0);
    border-bottom: 1px solid var(--border-0);
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .aside {
    margin-top: var(--space-5);
    max-width: 70ch;
  }

  .inline-link {
    color: var(--accent-1);
    font-weight: 600;
    text-decoration: none;
  }

  .inline-link:hover {
    text-decoration: underline;
  }

  .archive-head {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    max-width: 62ch;
  }

  .archive-head .btn {
    margin-top: var(--space-2);
  }

  .reach-lead {
    max-width: 66ch;
    margin-bottom: var(--space-5);
  }

  .reach-facts {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    border-top: 1px solid var(--border-0);
    padding-top: var(--space-5);
  }

  .reach-facts div {
    display: grid;
    gap: 0.2rem;
  }

  .reach-facts strong {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .reach-facts span {
    color: var(--text-2);
    font-size: 0.86rem;
  }

  .stats {
    padding: var(--space-6) var(--space-5);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .stat {
    display: grid;
    gap: 0.3rem;
  }

  .stat strong {
    font-size: clamp(2rem, 4vw, 2.9rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stat span {
    color: var(--text-2);
    font-size: 0.86rem;
  }

  .cta {
    margin-top: var(--space-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .cta .section-title {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
  }

  .cta p {
    margin: var(--space-2) 0 0;
  }

  @media (max-width: 960px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reach-facts {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .sec-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
