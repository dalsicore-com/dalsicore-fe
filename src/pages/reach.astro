---
import BaseLayout from "../layouts/BaseLayout.astro";
import AreaChart from "../components/charts/AreaChart.astro";
import BrandBars from "../components/charts/BrandBars.astro";
import { METRICS } from "../data/metrics";
import { APPS } from "../data/apps";

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC"
  });

const nameFor = (slug: string) =>
  APPS.find((a) => a.slug === slug)?.name ?? slug;

const rows = Object.entries(METRICS.perApp)
  .map(([slug, m]) => ({ slug, name: nameFor(slug), ...m }))
  .sort((a, b) => b.peak - a.peak);

const topCountries = METRICS.countries.slice(0, 12);
---

<BaseLayout
  title="Reach | Dalsicore"
  description="Ten years of Google Play Console data in one place. Installed audience, country breakdown and per-app history, straight from the exports."
>
  <section class="section container">
    <p class="eyebrow reveal">Reach</p>
    <h1 class="section-title reveal delay-1">The numbers, in the open.</h1>
    <p class="lead intro reveal delay-2">
      Every app we have shipped, tracked from {fmtDate(METRICS.range.start)} to
      {fmtDate(METRICS.range.end)}. This is the installed audience from Google Play Console: how
      many devices had one of our apps installed on any given day. It grows with installs and
      shrinks when people uninstall.
    </p>

    <dl class="stats reveal delay-2">
      <div>
        <dt>Apps tracked</dt>
        <dd>{METRICS.appsTracked}</dd>
      </div>
      <div>
        <dt>Peak installed audience</dt>
        <dd>{METRICS.peak.value.toLocaleString("en-US")}</dd>
        <dd class="sub">{fmtDate(METRICS.peak.date)}</dd>
      </div>
      <div>
        <dt>Countries reached</dt>
        <dd>{METRICS.countriesCount}</dd>
      </div>
      <div>
        <dt>Installed today</dt>
        <dd>{METRICS.current.toLocaleString("en-US")}</dd>
        <dd class="sub">across the retired fleet</dd>
      </div>
    </dl>
  </section>

  <section class="section container">
    <div class="chart-head reveal">
      <h2 class="group-title">Installed audience over time</h2>
      <p class="muted">All apps combined. Weekly samples. Hover the chart for any date.</p>
    </div>
    <AreaChart
      series={METRICS.series}
      id="combined"
      label="Combined installed audience across all apps, 2021 to 2026"
      height={300}
    />
    <p class="note reveal">
      The curve climbs through 2022 and 2023, peaks at
      <strong>{METRICS.peak.value.toLocaleString("en-US")}</strong>
      devices on {fmtDate(METRICS.peak.date)}, then eases as the listings were retired. Nothing
      here is smoothed or projected. It is the raw export.
    </p>
  </section>

  <section class="section container">
    <h2 class="group-title reveal">Where the users came from</h2>
    <p class="muted reveal">Peak installed audience per country, summed across all apps.</p>
    <div class="reveal">
      <BrandBars items={topCountries} showApps={true} />
    </div>
  </section>

  <section class="section container">
    <h2 class="group-title reveal">App by app</h2>
    <p class="muted reveal">Peak installed audience for each listing. Open one for its full history.</p>
    <div class="table-wrap reveal">
      <table>
        <thead>
          <tr>
            <th>App</th>
            <th class="num">Peak</th>
            <th>Peak date</th>
            <th class="num">Countries</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <td>
                  <a class="text-link" href={`/apps/${r.slug}`}>{r.name}</a>
                </td>
                <td class="num">{r.peak.toLocaleString("en-US")}</td>
                <td>{fmtDate(r.peakDate)}</td>
                <td class="num">{r.countries.length}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section container">
    <div class="source surface reveal">
      <h2>About this data</h2>
      <p>
        Source: Google Play Console, "Installed audience" (Audiens yang menginstal), daily export
        for each app, {fmtDate(METRICS.range.start)} to {fmtDate(METRICS.range.end)}. Country
        figures are the top markets Play reports per app. Charts are sampled weekly to keep the
        page light. Figures are shown exactly as exported, with no estimates.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--border-0);
  }
  .stats div {
    display: grid;
    gap: 0.15rem;
  }
  .stats dt {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-2);
  }
  .stats dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-0);
    font-variant-numeric: tabular-nums;
  }
  .stats dd.sub {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-2);
  }

  .chart-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .chart-head h2 {
    margin: 0;
  }
  .note {
    margin-top: var(--space-4);
    color: var(--text-1);
    font-size: 0.95rem;
    max-width: 68ch;
  }
  .note strong {
    color: var(--text-0);
  }

  .table-wrap {
    margin-top: var(--space-5);
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border-0);
    white-space: nowrap;
  }
  th {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-2);
    font-weight: 600;
  }
  td.num,
  th.num {
    text-align: right;
    font-family: var(--font-mono, monospace);
    font-variant-numeric: tabular-nums;
  }
  tbody tr:hover {
    background: var(--surface-1);
  }

  .source {
    padding: var(--space-5);
    max-width: 74ch;
  }
  .source h2 {
    margin: 0 0 var(--space-2);
    font-size: 1.05rem;
  }
  .source p {
    margin: 0;
    color: var(--text-1);
    font-size: 0.95rem;
  }

  @media (max-width: 760px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
    .stats dd {
      font-size: 1.5rem;
    }
  }
</style>
