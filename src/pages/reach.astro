---
import BaseLayout from "../layouts/BaseLayout.astro";
import AreaChart from "../components/charts/AreaChart.astro";
import BrandBars from "../components/charts/BrandBars.astro";
import { METRICS } from "../data/metrics";
import { APPS } from "../data/apps";

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC"
  });

const nameFor = (slug: string) =>
  APPS.find((a) => a.slug === slug)?.name ?? slug;

const rows = Object.entries(METRICS.perApp)
  .map(([slug, m]) => ({ slug, name: nameFor(slug), ...m }))
  .sort((a, b) => b.peak - a.peak);

const topCountries = METRICS.countries.slice(0, 12);

const ga4 = METRICS.ga4;
const asBars = (list: { name: string; v: number }[]) =>
  list.map((x) => ({ name: x.name, peak: x.v }));
---

<BaseLayout
  title="Reach | Dalsicore"
  description="Ten years of Google Play Console data in one place. Installed audience, country breakdown and per-app history, straight from the exports."
>
  <section class="section container">
    <p class="eyebrow reveal">Reach</p>
    <h1 class="section-title reveal delay-1">The numbers, in the open.</h1>
    <p class="lead intro reveal delay-2">
      Every app I have shipped, tracked from {fmtDate(METRICS.range.start)} to
      {fmtDate(METRICS.range.end)}. This is the installed audience from Google Play Console: how
      many devices had one of my apps installed on any given day. It grows with installs and
      shrinks when people uninstall.
    </p>

    <dl class="stats reveal delay-2">
      <div>
        <dt>Apps tracked</dt>
        <dd>{METRICS.appsTracked}</dd>
      </div>
      <div>
        <dt>Peak installed audience</dt>
        <dd>{METRICS.peak.value.toLocaleString("en-US")}</dd>
        <dd class="sub">{fmtDate(METRICS.peak.date)}</dd>
      </div>
      <div>
        <dt>Countries reached</dt>
        <dd>{METRICS.countriesCount}</dd>
      </div>
      <div>
        <dt>Installed today</dt>
        <dd>{METRICS.current.toLocaleString("en-US")}</dd>
        <dd class="sub">across the retired fleet</dd>
      </div>
    </dl>
  </section>

  <section class="section container">
    <div class="chart-head reveal">
      <h2 class="group-title">Installed audience over time</h2>
      <p class="muted">All apps combined. Weekly samples. Hover the chart for any date.</p>
    </div>
    <AreaChart
      series={METRICS.series}
      id="combined"
      label="Combined installed audience across all apps, 2021 to 2026"
      height={300}
    />
    <p class="note reveal">
      The curve climbs through 2022 and 2023, peaks at
      <strong>{METRICS.peak.value.toLocaleString("en-US")}</strong>
      devices on {fmtDate(METRICS.peak.date)}, then eases as the listings were retired. Nothing
      here is smoothed or projected. It is the raw export.
    </p>
  </section>

  <section class="section container">
    <h2 class="group-title reveal">Where the users came from</h2>
    <p class="muted reveal">Peak installed audience per country, summed across all apps.</p>
    <div class="reveal">
      <BrandBars items={topCountries} showApps={true} />
    </div>
  </section>

  <section class="section container">
    <h2 class="group-title reveal">App by app</h2>
    <p class="muted reveal">Peak installed audience for each listing. Open one for its full history.</p>
    <div class="table-wrap reveal">
      <table>
        <thead>
          <tr>
            <th>App</th>
            <th class="num">Peak</th>
            <th>Peak date</th>
            <th class="num">Countries</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <td>
                  <a class="text-link" href={`/apps/${r.slug}`}>{r.name}</a>
                </td>
                <td class="num">{r.peak.toLocaleString("en-US")}</td>
                <td>{fmtDate(r.peakDate)}</td>
                <td class="num">{r.countries.length}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section container">
    <div class="source surface reveal">
      <h2>About this data</h2>
      <p>
        Source: Google Play Console, "Installed audience" (Audiens yang menginstal), daily export
        for each app, {fmtDate(METRICS.range.start)} to {fmtDate(METRICS.range.end)}. Country
        figures are the top markets Play reports per app. Charts are sampled weekly to keep the
        page light. Figures are shown exactly as exported, with no estimates.
      </p>
    </div>
  </section>

  <!-- Analytics (GA4 / Firebase) -->
  <section class="section band">
    <div class="container">
      <p class="eyebrow reveal">Analytics</p>
      <h2 class="section-title reveal delay-1">Product analytics, 2020 to 2026.</h2>
      <p class="lead reach-lead reveal delay-2">
        A second, separate source: Google Analytics for Firebase on the combined Android property.
        Where the Play figures count devices, this counts the people who actually opened the apps,{" "}
        {fmtDate(ga4.range.start)} to {fmtDate(ga4.range.end)}. Different tool, different metric, so
        it sits apart from the Play layer above. The two are never added together.
      </p>

      <dl class="stats reveal delay-2">
        <div>
          <dt>Peak monthly active (30d)</dt>
          <dd>{ga4.peak.mau.value.toLocaleString("en-US")}</dd>
          <dd class="sub">{fmtDate(ga4.peak.mau.date)}</dd>
        </div>
        <div>
          <dt>Peak weekly active (7d)</dt>
          <dd>{ga4.peak.wau.value.toLocaleString("en-US")}</dd>
          <dd class="sub">{fmtDate(ga4.peak.wau.date)}</dd>
        </div>
        <div>
          <dt>Peak daily active (1d)</dt>
          <dd>{ga4.peak.dau.value.toLocaleString("en-US")}</dd>
          <dd class="sub">{fmtDate(ga4.peak.dau.date)}</dd>
        </div>
        <div>
          <dt>New users, all time</dt>
          <dd>{ga4.newUsersTotal.toLocaleString("en-US")}</dd>
          <dd class="sub">everyone who ever opened the apps</dd>
        </div>
      </dl>

      <p class="muted clarify reveal delay-3">
        Read these four together and it makes sense: {ga4.newUsersTotal.toLocaleString("en-US")} people
        tried the apps at some point over six years, but they never overlapped much. The busiest the
        apps ever were at once was {ga4.peak.mau.value.toLocaleString("en-US")} monthly active users.
        That gap is the honest story of a fleet with lots of reach and little retention.
      </p>
    </div>
  </section>

  <section class="section container">
    <div class="chart-head reveal">
      <h2 class="group-title">Monthly active users</h2>
      <p class="muted">Rolling 30-day active users. Weekly samples.</p>
    </div>
    <AreaChart
      series={ga4.series}
      id="ga4-mau"
      label="Monthly active users, 2020 to 2026"
      height={280}
    />
    <p class="note reveal">
      The product analytics peak at <strong>{ga4.peak.mau.value.toLocaleString("en-US")}</strong>{" "}
      monthly active users on {fmtDate(ga4.peak.mau.date)}, then settle as the apps were retired.
    </p>
  </section>

  <section class="section container">
    <h2 class="group-title reveal">Where the users were</h2>
    <p class="muted reveal">
      Active users by country ({ga4.countriesCount} countries in total). Google Analytics figures,
      separate from the Play table above.
    </p>
    <div class="reveal">
      <BrandBars items={ga4.countries.map((c) => ({ name: c.name, peak: c.active }))} />
    </div>
  </section>

  <section class="section container">
    <div class="ga4-grid reveal">
      <div>
        <h3 class="mini-title">Languages</h3>
        <BrandBars items={asBars(ga4.languages)} />
      </div>
      <div>
        <h3 class="mini-title">Age</h3>
        <BrandBars items={asBars(ga4.ages)} />
      </div>
      <div>
        <h3 class="mini-title">First touch channel</h3>
        <BrandBars items={asBars(ga4.channels)} />
      </div>
    </div>
    <div class="rev-head reveal">
      <h3 class="mini-title">Revenue</h3>
      <p class="muted rev-lead">
        Google Analytics ships these figures as bare numbers with no currency label. At this scale
        they only read as Indonesian rupiah, so that is how they are shown. Total is the whole
        fleet over six years.
      </p>
    </div>

    <dl class="stats reveal">
      <div>
        <dt>Total, all apps</dt>
        <dd>Rp {ga4.revenue.total.toLocaleString("en-US")}</dd>
        <dd class="sub">2020 to 2026</dd>
      </div>
      <div>
        <dt>From ads</dt>
        <dd>Rp {ga4.revenue.ads.toLocaleString("en-US")}</dd>
        <dd class="sub">{Math.round(ga4.revenue.adShare * 100)}% of the total</dd>
      </div>
      <div>
        <dt>From purchases</dt>
        <dd>Rp {ga4.revenue.purchases.toLocaleString("en-US")}</dd>
        <dd class="sub">one-off in-app purchases</dd>
      </div>
    </dl>

    <div class="rev-note reveal">
      <h3 class="mini-title">Revenue by country</h3>
      <BrandBars items={asBars(ga4.revenue.countries)} />
    </div>

    <div class="source surface reveal note-src">
      <h2>About the analytics</h2>
      <p>
        Source: Google Analytics 4 (Firebase), property "Android App", {fmtDate(ga4.range.start)}{" "}
        to {fmtDate(ga4.range.end)}. Active users are Google's rolling windows: 30-day, 7-day and
        1-day. New users is the running total of unique first-time users over the whole period, not
        a simultaneous figure. Country, language, age and channel come from Google's own reports.
        There is no currency in the export, so the revenue figures above are read as Indonesian
        rupiah.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--border-0);
  }
  .stats div {
    display: grid;
    gap: 0.15rem;
  }
  .stats dt {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-2);
  }
  .stats dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-0);
    font-variant-numeric: tabular-nums;
  }
  .stats dd.sub {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-2);
  }

  .chart-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .chart-head h2 {
    margin: 0;
  }
  .note {
    margin-top: var(--space-4);
    color: var(--text-1);
    font-size: 0.95rem;
    max-width: 68ch;
  }
  .note strong {
    color: var(--text-0);
  }

  .table-wrap {
    margin-top: var(--space-5);
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border-0);
    white-space: nowrap;
  }
  th {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-2);
    font-weight: 600;
  }
  td.num,
  th.num {
    text-align: right;
    font-family: var(--font-mono, monospace);
    font-variant-numeric: tabular-nums;
  }
  tbody tr:hover {
    background: var(--surface-1);
  }

  .source {
    padding: var(--space-5);
    max-width: 74ch;
  }
  .source h2 {
    margin: 0 0 var(--space-2);
    font-size: 1.05rem;
  }
  .source p {
    margin: 0;
    color: var(--text-1);
    font-size: 0.95rem;
  }

  .ga4-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .mini-title {
    margin: 0 0 var(--space-3);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-2);
    font-weight: 600;
  }
  .note-src {
    margin-top: var(--space-6);
  }

  .clarify {
    margin: var(--space-5) 0 0;
    max-width: 72ch;
    font-size: 0.95rem;
  }

  .rev-head {
    margin: var(--space-6) 0 var(--space-4);
  }
  .rev-lead {
    max-width: 68ch;
    margin: 0;
    font-size: 0.95rem;
  }
  .rev-note {
    margin-top: var(--space-6);
  }

  @media (max-width: 760px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
    .stats dd {
      font-size: 1.5rem;
    }
    .ga4-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
