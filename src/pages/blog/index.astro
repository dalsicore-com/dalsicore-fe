---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags.map((tag) => tag.toLowerCase())))
).sort();
---

<BaseLayout title="Blog | Dalsicore" description="Development notes, experiments, and research insights.">
  <section class="section container">
    <p class="eyebrow reveal">Developer Journal</p>
    <h1 class="section-title reveal delay-1">Blog</h1>
    <p class="muted intro reveal delay-2">
      Notes on Android engineering, design experiments, and research that can become real products.
    </p>

    {
      allTags.length > 0 && (
        <div class="tags reveal delay-2">
          {allTags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    <div class="grid reveal delay-3">
      {
        posts.map((entry) => (
          <BlogCard
            href={`/blog/${entry.slug}`}
            title={entry.data.title}
            excerpt={entry.data.excerpt}
            publishedAt={entry.data.publishedAt}
            tags={entry.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    margin-top: var(--space-3);
    max-width: 62ch;
  }

  .tags {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
