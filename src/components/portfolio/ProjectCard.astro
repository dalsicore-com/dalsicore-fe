---
interface Props {
  href: string;
  title: string;
  summary: string;
  status: string;
  stack: string[];
  index?: number;
}

const { href, title, summary, status, stack = [], index = 0 } = Astro.props;
const featured = index === 0;
---

<a class={`card surface ${index % 2 === 1 ? "offset" : ""} ${featured ? "featured" : ""}`} href={href}>
  <div class="top">
    <h3>{title}</h3>
    <span>{status}</span>
  </div>
  <p>{summary}</p>
  <div class="tags">
    {stack.map((item) => <span class="tag">{item}</span>)}
  </div>
</a>

<style>
  .card {
    position: relative;
    overflow: hidden;
    text-decoration: none;
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: auto -50px -70px auto;
    width: 170px;
    height: 170px;
    background: radial-gradient(circle, rgba(230, 167, 110, 0.18), transparent 70%);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-0);
    background: var(--surface-2);
    box-shadow: 0 22px 36px rgba(8, 5, 4, 0.36);
  }

  .card:hover::before {
    opacity: 1;
  }

  .card.featured::after {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(120deg, rgba(230, 167, 110, 0.62), rgba(242, 190, 140, 0.15), rgba(230, 167, 110, 0.62));
    background-size: 220% 100%;
    animation: borderFlow 5.5s linear infinite;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .card.offset {
    transform: translateY(14px);
  }

  .card.offset:hover {
    transform: translateY(10px);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  h3 {
    margin: 0;
    font-size: 1.16rem;
    font-family: var(--font-serif);
    font-weight: 600;
  }

  .top span {
    color: var(--accent-2);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  p {
    margin: 0;
    color: var(--text-1);
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 960px) {
    .card.offset,
    .card.offset:hover {
      transform: none;
    }
  }
</style>
