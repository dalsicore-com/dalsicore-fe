---
import { NAV_LINKS } from "../../lib/constants";
import BrandMark from "./BrandMark.astro";

const path = Astro.url.pathname;
---

<header class="nav-wrap">
  <nav class="container nav">
    <a class="brand" href="/" aria-label="Dalsicore Home">
      <BrandMark />
      <span>Dalsicore</span>
    </a>
    <ul>
      {
        NAV_LINKS.map((item) => (
          <li>
            <a href={item.href} class={path === item.href ? "active" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(6px);
    background: rgba(10, 13, 18, 0.78);
    border-bottom: 1px solid var(--border-0);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 64px;
    gap: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--text-0);
  }

  .brand :global(.brand-mark) {
    width: 1.2rem;
    height: auto;
    color: var(--brand-mark);
    filter: drop-shadow(0 0 8px rgba(127, 179, 255, 0.22));
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  li a {
    text-decoration: none;
    color: var(--text-2);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: var(--font-mono);
    padding: 0.12rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  li a:hover,
  li a.active {
    color: var(--text-0);
    border-bottom-color: var(--border-1);
  }

  @media (max-width: 760px) {
    .nav {
      flex-direction: column;
      align-items: flex-start;
      padding-block: var(--space-3);
    }

    ul {
      width: 100%;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
    }
  }
</style>
