---
import BrandMark from "./BrandMark.astro";
---

<footer class="footer">
  <div class="container content">
    <span class="brand-chip">
      <BrandMark />
      <span>Dalsicore.</span>
    </span>
    <span>Research and innovation. © {new Date().getFullYear()}</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-7);
    border-top: 1px solid var(--border-0);
    padding-block: var(--space-5);
  }

  .content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-2);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    letter-spacing: 0.01em;
  }

  .brand-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--text-1);
  }

  .brand-chip :global(.brand-mark) {
    width: 0.95rem;
    height: auto;
    color: var(--brand-mark);
    filter: drop-shadow(0 0 6px rgba(127, 179, 255, 0.18));
  }

  @media (max-width: 760px) {
    .content {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
