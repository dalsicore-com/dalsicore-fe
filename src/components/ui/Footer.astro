---
import BrandMark from "./BrandMark.astro";
import { CONTACT } from "../../lib/constants";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container content">
    <div class="col brand-col">
      <span class="brand-chip">
        <BrandMark />
        <span>Dalsicore</span>
      </span>
      <p class="tagline">Android products and applied research, built AI-native.</p>
      <p class="location">Solo studio based in Indonesia</p>
    </div>

    <div class="col">
      <h4>Explore</h4>
      <a href="/portfolio">Products</a>
      <a href="/archive">Archive</a>
      <a href="/research">Research</a>
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
    </div>

    <div class="col">
      <h4>Elsewhere</h4>
      <a href={CONTACT.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={CONTACT.play} target="_blank" rel="noopener noreferrer">Google Play</a>
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
    </div>
  </div>

  <div class="container bottom">
    <span>© {year} Dalsicore. Built in Indonesia.</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--border-0);
    background: var(--bg-1);
    padding-top: var(--space-7);
    padding-bottom: var(--space-5);
  }

  .content {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-6);
  }

  .brand-col {
    max-width: 34ch;
  }

  .brand-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-0);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: var(--space-3) 0 0;
    color: var(--text-1);
    font-size: 0.92rem;
  }

  .location {
    margin: var(--space-2) 0 0;
    color: var(--text-2);
    font-size: 0.84rem;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  h4 {
    margin: 0 0 0.3rem;
    color: var(--text-2);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .col a {
    color: var(--text-1);
    font-size: 0.92rem;
    text-decoration: none;
    width: fit-content;
    transition: color 0.16s ease;
  }

  .col a:hover {
    color: var(--accent-1);
  }

  .bottom {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-0);
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--text-2);
    font-size: 0.82rem;
  }

  @media (max-width: 820px) {
    .content {
      grid-template-columns: 1fr 1fr;
    }

    .brand-col {
      grid-column: 1 / -1;
    }

    .bottom {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
