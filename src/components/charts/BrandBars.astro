---
/**
 * Horizontal bar list for country (or any) breakdowns.
 * Bars are scaled to the largest value in the list.
 */
interface Bar {
  name: string;
  peak: number;
  latest?: number;
  apps?: number;
}
interface Props {
  items: Bar[];
  /** Show the small "N apps" note. */
  showApps?: boolean;
  valueLabel?: string;
}

const { items, showApps = false, valueLabel = "peak" } = Astro.props;
const max = Math.max(1, ...items.map((i) => i.peak));
---

<ul class="bars" role="list">
  {items.map((it) => (
    <li class="bar-row">
      <span class="b-name">{it.name}</span>
      <span class="b-track" aria-hidden="true">
        <span class="b-fill" style={`width:${((it.peak / max) * 100).toFixed(1)}%`} />
      </span>
      <span class="b-val">
        {it.peak.toLocaleString("en-US")}
        {showApps && it.apps ? <em>{it.apps} {it.apps === 1 ? "app" : "apps"}</em> : null}
      </span>
    </li>
  ))}
</ul>

<style>
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .bar-row {
    display: grid;
    grid-template-columns: 130px 1fr 74px;
    align-items: center;
    gap: var(--space-3);
  }
  .b-name {
    font-size: 0.9rem;
    color: var(--text-0);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .b-track {
    display: block;
    height: 10px;
    background: var(--surface-2);
    border-radius: 3px;
    overflow: hidden;
  }
  .b-fill {
    display: block;
    height: 100%;
    background: var(--accent-0);
    border-radius: 3px;
    transition: width 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .b-val {
    font-family: var(--font-mono, monospace);
    font-size: 0.82rem;
    color: var(--text-1);
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
  }
  .b-val em {
    font-style: normal;
    font-size: 0.68rem;
    color: var(--text-2);
  }
  @media (max-width: 560px) {
    .bar-row {
      grid-template-columns: 96px 1fr 60px;
    }
  }
</style>
