---
import { formatDate } from "../../lib/date";

interface Props {
  href: string;
  title: string;
  excerpt: string;
  publishedAt: Date;
  tags?: string[];
}

const { href, title, excerpt, publishedAt, tags = [] } = Astro.props;
---

<a class="card surface" href={href}>
  <p class="date">{formatDate(publishedAt)}</p>
  <h3>{title}</h3>
  <p class="excerpt">{excerpt}</p>
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .card {
    text-decoration: none;
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-0);
  }

  .date {
    margin: 0;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 0;
    font-size: 1.2rem;
    font-family: var(--font-serif);
    font-weight: 500;
    line-height: 1.25;
  }

  .excerpt {
    margin: 0;
    color: var(--text-1);
  }

  .tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
</style>
