---
import { formatDate } from "../../lib/date";

interface Props {
  href: string;
  title: string;
  excerpt: string;
  publishedAt: Date;
  author: string;
  thumbnail?: string;
  tags?: string[];
}

const { href, title, excerpt, publishedAt, author, thumbnail, tags = [] } = Astro.props;
---

<a class="card surface" href={href}>
  {
    thumbnail && (
      <div class="thumb-wrap">
        <img src={thumbnail} alt="" class="thumb" loading="lazy" decoding="async" />
      </div>
    )
  }
  <p class="meta">Posted on {formatDate(publishedAt)} by {author}</p>
  <h3>{title}</h3>
  <p class="excerpt">{excerpt}</p>
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .card {
    text-decoration: none;
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-0);
    background: var(--surface-2);
  }

  .meta {
    margin: 0;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  .thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border-0);
    border-radius: var(--radius-1);
    overflow: hidden;
    background: var(--surface-2);
  }

  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h3 {
    margin: 0;
    font-size: 1.12rem;
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.3;
  }

  .excerpt {
    margin: 0;
    color: var(--text-1);
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
</style>
