---
import { formatDate } from "../../lib/date";

interface Props {
  href: string;
  title: string;
  excerpt: string;
  publishedAt: Date;
  author: string;
  thumbnail?: string;
  tags?: string[];
  index?: number;
}

const { href, title, excerpt, publishedAt, thumbnail, tags = [] } = Astro.props;
---

<a class="card surface" href={href}>
  {
    thumbnail && (
      <div class="thumb-wrap">
        <img src={thumbnail} alt="" class="thumb" loading="lazy" decoding="async" />
      </div>
    )
  }
  <p class="meta">{formatDate(publishedAt)}</p>
  <h3>{title}</h3>
  <p class="excerpt">{excerpt}</p>
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--border-1);
    box-shadow: var(--shadow-1);
  }

  .meta {
    margin: 0;
    color: var(--text-2);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-1);
    overflow: hidden;
    background: var(--surface-2);
    margin-bottom: 0.2rem;
  }

  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h3 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .excerpt {
    margin: 0;
    color: var(--text-1);
    font-size: 0.94rem;
  }

  .tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: 0.15rem;
  }
</style>
