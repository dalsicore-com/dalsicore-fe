---
import { formatDate } from "../../lib/date";

interface Props {
  href: string;
  title: string;
  excerpt: string;
  publishedAt: Date;
  author: string;
  thumbnail?: string;
  tags?: string[];
  index?: number;
}

const { href, title, excerpt, publishedAt, author, thumbnail, tags = [], index = 0 } = Astro.props;
const featured = index === 0;
---

<a class={`card surface ${index % 2 === 1 ? "offset" : ""} ${featured ? "featured" : ""}`} href={href}>
  {
    thumbnail && (
      <div class="thumb-wrap">
        <img src={thumbnail} alt="" class="thumb" loading="lazy" decoding="async" />
      </div>
    )
  }
  <p class="meta">Posted on {formatDate(publishedAt)} by {author}</p>
  <h3>{title}</h3>
  <p class="excerpt">{excerpt}</p>
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .card {
    position: relative;
    overflow: hidden;
    text-decoration: none;
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
    transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: -50px auto auto -50px;
    width: 160px;
    height: 160px;
    background: radial-gradient(circle, rgba(230, 167, 110, 0.15), transparent 70%);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-0);
    background: var(--surface-2);
    box-shadow: 0 22px 36px rgba(8, 5, 4, 0.36);
  }

  .card:hover::before {
    opacity: 1;
  }

  .card.featured::after {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(120deg, rgba(230, 167, 110, 0.62), rgba(242, 190, 140, 0.15), rgba(230, 167, 110, 0.62));
    background-size: 220% 100%;
    animation: borderFlow 5.5s linear infinite;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .card.offset {
    transform: translateY(14px);
  }

  .card.offset:hover {
    transform: translateY(10px);
  }

  .meta {
    margin: 0;
    color: var(--text-2);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    font-weight: 600;
    line-height: 1.5;
  }

  .thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border-0);
    border-radius: var(--radius-1);
    overflow: hidden;
    background: var(--surface-2);
  }

  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h3 {
    margin: 0;
    font-size: 1.12rem;
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.3;
  }

  .excerpt {
    margin: 0;
    color: var(--text-1);
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  @media (max-width: 960px) {
    .card.offset,
    .card.offset:hover {
      transform: none;
    }
  }
</style>
