---
import type { AppEntry } from "../../data/apps";

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
---

<a class="app-card surface" href={`/apps/${app.slug}`}>
  <div class="head">
    <img class="icon" src={app.icon} alt="" width="56" height="56" loading="lazy" decoding="async" />
    <div class="titles">
      <h3>{app.name}</h3>
      <span class="cat">{app.category}</span>
    </div>
    {
      app.status === "live" ? (
        <span class="status live">Live</span>
      ) : (
        <span class="status">Retired {app.retired}</span>
      )
    }
  </div>

  <p class="desc">{app.tagline}</p>

  <div class="foot">
    {app.rating && <span class="metric">★ {app.rating.toFixed(1)}</span>}
    {app.links?.play && <span class="metric">On Google Play</span>}
  </div>
</a>

<style>
  .app-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .app-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-1);
    box-shadow: var(--shadow-1);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .icon {
    border-radius: 14px;
    flex: none;
    background: var(--surface-2);
  }

  .titles {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cat {
    color: var(--text-2);
    font-size: 0.78rem;
  }

  .status {
    flex: none;
    border: 1px solid var(--border-0);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
    color: var(--text-2);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .status.live {
    border-color: rgba(34, 197, 94, 0.4);
    color: #15803d;
    background: rgba(34, 197, 94, 0.08);
  }

  .desc {
    margin: 0;
    color: var(--text-1);
    font-size: 0.95rem;
  }

  .foot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: 0.2rem;
  }

  .metric {
    color: var(--text-2);
    font-size: 0.78rem;
    font-weight: 600;
  }

</style>
