---
import BrandMark from "../ui/BrandMark.astro";
import { LIVE_APPS } from "../../data/apps";

const live = LIVE_APPS[0];
---

<section class="hero">
  <div class="container inner">
    <div class="badge reveal">
      <span class="dot" aria-hidden="true"></span>
      {live.name} is live on Google Play
    </div>

    <h1 class="statement reveal delay-1">
      Ship fast. Learn faster.<br />
      Build what lasts.
    </h1>

    <p class="sub reveal delay-2">
      Dalsicore is a solo-founded Android studio in Indonesia. We shipped 20+ apps, learned
      what fails, and now build AI-native products with Claude.
    </p>

    <div class="actions reveal delay-3">
      <a class="btn btn-primary" href="/portfolio">See what we're building</a>
      <a class="btn btn-ghost" href="/archive">The honest archive</a>
    </div>

    <div class="brand-line reveal delay-4">
      <BrandMark />
      <span>Euni Dev → Dalsicore · building since 2022</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    background:
      radial-gradient(60% 80% at 85% 0%, rgba(217, 138, 134, 0.12), transparent 60%),
      radial-gradient(50% 70% at 0% 10%, rgba(60, 86, 244, 0.08), transparent 55%);
  }

  .inner {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 60rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border-0);
    background: var(--surface-1);
    border-radius: var(--radius-pill);
    padding: 0.34rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-1);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.16);
  }

  .statement {
    margin: 0;
    font-size: clamp(2.6rem, 7.2vw, 5.4rem);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.045em;
    color: var(--text-0);
  }

  .sub {
    margin: 0;
    max-width: 58ch;
    color: var(--text-1);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.55;
  }

  .actions {
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .brand-line {
    margin-top: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-2);
    font-size: 0.88rem;
    font-weight: 500;
  }
</style>
